<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <title>Reflex - Sign In</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "dark_mode", "data-turbo-track": "reload" %>

  <%# Prevent flash of unstyled content by setting theme before render %>
  <script>
    (function() {
      const saved = localStorage.getItem('reflex-dark-mode');
      if (saved === 'dark') {
        document.documentElement.classList.add('dark');
      } else if (saved === 'light') {
        document.documentElement.classList.add('light');
      }
    })();
  </script>
</head>
<body class="h-full dm-bg" style="font-family: 'Inter', system-ui, sans-serif;">
  <div class="min-h-full flex items-center justify-center px-6">
    <div class="w-full max-w-sm">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="flex justify-center mb-4">
          <svg width="40" height="40" viewBox="0 0 20 20" fill="none">
            <path d="M10 2L18 10L10 18L2 10L10 2Z" fill="#E54D2E"/>
          </svg>
        </div>
        <h1 class="text-[20px] font-semibold tracking-tight dm-text">Reflex</h1>
        <p class="text-[14px] mt-1 dm-text-subtle">Error tracking with instant reaction</p>
      </div>

      <!-- Form -->
      <div class="rounded-xl p-6 dm-card">
        <h2 class="text-[15px] font-semibold mb-4 dm-text">Sign in to your project</h2>

        <%= form_tag dashboard_root_path, method: :get, class: "space-y-4" do %>
          <div>
            <label for="api_key" class="block text-[13px] font-medium mb-1.5 dm-text-muted">API Key</label>
            <input type="password" name="api_key" id="api_key" autofocus
                   class="w-full px-3 py-2 rounded-lg text-[14px] outline-none transition-colors dm-input"
                   placeholder="rfx_a_...">
          </div>
          <button type="submit"
                  class="w-full py-2.5 text-[14px] font-medium rounded-lg transition-colors"
                  style="background: var(--dm-text); color: var(--dm-bg);">
            Continue
          </button>
        <% end %>
      </div>

      <p class="text-center text-[13px] mt-6 dm-text-subtle">
        Get your API key from
        <a href="https://brainzlab.ai/dashboard" class="font-medium hover:underline" style="color: #E54D2E;">Brainz Lab</a>
      </p>
    </div>
  </div>
</body>
</html>
