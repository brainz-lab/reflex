<div class="space-y-8">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <h1 class="text-[22px] font-semibold tracking-tight dm-text">Projects</h1>
    <% unless Rails.env.production? %>
      <%= link_to new_dashboard_project_path,
          class: "inline-flex items-center gap-2 px-4 py-2 text-[13px] font-medium rounded-lg transition-colors",
          style: "background: var(--color-reflex); color: white;" do %>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M7 1v12M1 7h12"/>
        </svg>
        New Project
      <% end %>
    <% end %>
  </div>

  <!-- Projects List - Flat Rows -->
  <% if @projects.any? %>
    <div class="space-y-2">
      <% @projects.each do |project| %>
        <% is_current = session[:platform_project_id] == project.platform_project_id %>
        <% project_url = is_current || Rails.env.development? ? dashboard_project_errors_path(project) : sso_url_for_project(project.platform_project_id) %>
        <%= link_to project_url, class: "block group" do %>
          <div class="px-5 py-4 rounded-xl transition-all dm-row <%= is_current ? 'ring-1' : '' %>" style="<%= is_current ? '--tw-ring-color: var(--color-reflex);' : '' %>">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(228, 91, 58, 0.15);">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path d="M10 2L18 10L10 18L2 10L10 2Z" fill="var(--color-reflex)"/>
                  </svg>
                </div>
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2">
                    <h3 class="text-[15px] font-medium group-hover:underline dm-text"><%= project.name %></h3>
                    <% if is_current %>
                      <span class="px-1.5 py-0.5 text-[10px] font-medium rounded" style="background: rgba(228, 91, 58, 0.15); color: var(--color-reflex);">Current</span>
                    <% end %>
                  </div>
                  <p class="text-[13px] dm-text-muted"><%= project.environment || 'development' %></p>
                </div>
              </div>
              <div class="flex items-center gap-6">
                <% unresolved_count = @unresolved_counts[project.id] || 0 %>
                <% if unresolved_count > 0 %>
                  <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded text-[12px] font-medium"
                        style="background: var(--dm-error-bg); color: var(--dm-error-text);">
                    <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--dm-error);"></span>
                    <%= unresolved_count %> unresolved
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2 py-1 rounded text-[12px] font-medium"
                        style="background: var(--dm-success-bg); color: var(--dm-success-text);">
                    All clear
                  </span>
                <% end %>
                <span class="text-[12px] font-mono dm-text-placeholder"><%= @error_group_counts[project.id] || 0 %> errors</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="dm-text-placeholder">
                  <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 rounded-xl dm-surface">
      <div class="space-y-3">
        <p class="text-[15px] dm-text-secondary">No projects yet</p>
        <% if Rails.env.production? %>
          <%= link_to 'Go to Platform', ENV.fetch('BRAINZLAB_PLATFORM_EXTERNAL_URL', 'https://platform.brainzlab.ai'), target: "_blank", class: "text-[14px] font-medium hover:underline", style: "color: var(--color-reflex);" %>
        <% else %>
          <%= link_to 'Create your first project', new_dashboard_project_path, class: "text-[14px] font-medium hover:underline", style: "color: var(--color-reflex);" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
